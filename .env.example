# Copy to .env at the repo root. Leave blank to run the pet with study and vision turned off.
# Do not commit .env. Do not paste keys into chat.

# Gemini API key from Google AI Studio. https://aistudio.google.com/apikey
GEMINI_API_KEY=
MODEL_ID=gemini-3.5-flash-lite

# SerpApi. https://serpapi.com/pricing
SERPAPI_KEY=

PORT=3000
