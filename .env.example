# Copy to `.env` and fill in. Only WXT_* variables are exposed to the extension bundle.
# The built extension is loaded unpacked on your own machine — never commit `.env`.

# --- Gemini (all AI: screen checks, roasts, chat, study room, quizzes) ---
WXT_GEMINI_API_KEY=
# Confirmed against https://ai.google.dev/gemini-api/docs/models on 2026-10-24
WXT_GEMINI_MODEL=gemini-3.8-flash
WXT_GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# --- Optional: SerpAPI (reserved; not used by any feature yet) ---
WXT_SERPAPI_KEY=

# --- Firebase (social features; see README "Firebase setup") ---
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_AUTH_DOMAIN=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_APP_ID=
